node_modules/
dist/
server-go/bin/
app/server-go/bin/
.build/
*.tsbuildinfo
.tmp-*

# 打包产物与工具链（fnpack 首次构建自动下载）
*.fpk
.toolchain/

# 运行时数据（开发调试用）
/data/
.dev-data/
*.db
