# 截图产物（tools/*_shot.mjs 与 E2E 现画，可复跑，单次可达 200M+）
_shots/
tools/_shots/

# 系统杂项
.DS_Store
Thumbs.db
*.log

# 性能探针 JSON（tools/perf_*.mjs --out）
tools/_perf/

# 本地开发用的漫画目录（dev.sh 的 COMIC_ROOT 缺省值）
.dev-comics/
